; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="mining"
run/main_scene="uid://cekd7d8adtwrp"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
SettingsPanel="*res://scripts/SettingsPanel.gd"
Economy="*res://scripts/economy/Economy.gd"
WorldState="*res://scripts/economy/WorldState.gd"
GameSave="*res://scripts/save/GameSave.gd"
MissionOps="*res://scripts/missionops/MissionOps.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/preview_cam/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
